<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#171717"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enquiry_header"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contact_page_subheader"
                    android:textColor="#DDDDDD"
                    android:textSize="10sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnContactBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enquiry_back"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/enquiry_contact_title"
            android:textColor="#C8102E"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/enquiry_contact_subtitle"
            android:textColor="#64748B"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enquiry_institute_name"
                android:textColor="#142B45"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/enquiry_address"
                android:textColor="#424B57"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/enquiry_phone"
                android:textColor="#142B45"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enquiry_fax"
                android:textColor="#142B45"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/enquiry_email"
                android:textColor="#142B45"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnCallGmi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/enquiry_call_button"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#C8102E"/>

            <Button
                android:id="@+id/btnEmailGmi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/enquiry_email_button"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#142B45"/>

            <Button
                android:id="@+id/btnOpenGmiMap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/enquiry_map_button"
                android:textColor="#142B45"
                android:textStyle="bold"
                android:backgroundTint="#E5EAF0"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="18dp"
            android:gravity="center"
            android:background="#171717"
            android:text="@string/enquiry_footer"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
