<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/bg_splash">

    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="138dp"
        android:layout_height="138dp"
        android:background="@drawable/bg_splash_logo_badge"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/gmi_logo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/splash_app_title"
        android:textColor="#FFFFFF"
        android:textSize="27sp"
        android:textStyle="bold"
        android:letterSpacing="0.03" />

    <View
        android:layout_width="54dp"
        android:layout_height="4dp"
        android:layout_marginTop="15dp"
        android:background="#C8102E" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:gravity="center"
        android:text="@string/splash_tagline"
        android:textColor="#E8EDF3"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="@string/splash_location"
        android:textColor="#C7D1DC"
        android:textSize="11sp"
        android:letterSpacing="0.08" />

</LinearLayout>
